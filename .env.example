# AGY Study Manager — local environment template
# Copy this file to .env, then set only the values you need.
# Never commit .env or paste production secrets into chat/issues.

# Application runtime
APP_ENV=development
PORT=5000
FLASK_DEBUG=true

# Scheduler is disabled by default on developer machines to avoid sending
# duplicate notifications. Enable it only for the one intended scheduler host.
SCHEDULER_ENABLED=false

# Database
# Leave DATABASE_URL empty to use the local SQLite database below.
# For Supabase, paste the full PostgreSQL URI copied from Supabase Connect.
DATABASE_URL=
DB_PATH=./data/database.db

# Material attachments. On Railway, mount a Volume at /app/data so uploaded
# files survive redeploys, then set UPLOAD_DIR=/app/data/uploads.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# Optional notifications. Leave blank if they are not configured.
NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
